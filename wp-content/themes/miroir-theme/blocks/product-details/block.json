{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "miroir/product-details",
	"title": "Product details column",
	"category": "miroir",
	"icon": "align-left",
	"description": "Product info, buy box and previous/next links.",
	"textdomain": "miroir",
	"attributes": {},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"multiple": true
	},
	"editorScript": "miroir-blocks-site",
	"render": "file:./render.php",
	"ancestor": [
		"miroir/product"
	],
	"miroir": {
		"controls": [],
		"container": {
			"tag": "div",
			"className": "pdp__info",
			"template": [
				[
					"miroir/product-info"
				],
				[
					"miroir/product-buy"
				],
				[
					"miroir/product-pager"
				]
			]
		}
	}
}
