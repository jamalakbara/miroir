{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "miroir/logo",
	"title": "Logo",
	"category": "miroir",
	"icon": "format-image",
	"description": "Uploaded logo (Site Identity / Styles) or the Miroir wordmark.",
	"textdomain": "miroir",
	"attributes": {
		"width": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"multiple": true
	},
	"editorScript": "miroir-blocks-site",
	"render": "file:./render.php",
	"ancestor": [
		"miroir/site-nav"
	],
	"miroir": {
		"controls": [
			{
				"attr": "width",
				"type": "number",
				"label": "Uploaded logo width (px)",
				"help": "0: 110 px. The wordmark keeps its size."
			}
		]
	}
}
