{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "miroir/product",
	"title": "Product page",
	"category": "miroir",
	"icon": "products",
	"description": "Holds the product sections. Sold-out, choose-size and added-to-bag states replace them automatically.",
	"textdomain": "miroir",
	"attributes": {},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"multiple": false
	},
	"editorScript": "miroir-blocks-site",
	"render": "file:./render.php",
	"miroir": {
		"controls": [],
		"container": {
			"tag": "div",
			"className": "miroir-product",
			"template": [
				[
					"miroir/product-main"
				],
				[
					"miroir/similar-products"
				]
			]
		}
	}
}
