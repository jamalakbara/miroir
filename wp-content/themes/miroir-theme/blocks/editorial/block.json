{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "miroir/editorial",
	"title": "Editorial pair",
	"category": "miroir",
	"icon": "format-gallery",
	"description": "Two images side by side (one small, one large) with a caption, linking to a collection or page.",
	"keywords": [ "image", "home", "collection" ],
	"textdomain": "miroir",
	"attributes": {
		"layout": { "type": "string", "enum": [ "small-first", "large-first" ], "default": "small-first" },
		"smallImage": { "type": "number", "default": 0 },
		"largeImage": { "type": "number", "default": 0 },
		"caption": { "type": "string", "default": "" },
		"url": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "className": false, "customClassName": false },
	"editorScript": "miroir-blocks-editor",
	"render": "file:./render.php"
}
