{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "miroir/copyright",
	"title": "Copyright",
	"category": "miroir",
	"icon": "info",
	"description": "Copyright line. {year} is the current year, {site} the site title.",
	"textdomain": "miroir",
	"attributes": {
		"format": {
			"type": "string",
			"default": ""
		},
		"creditLabel": { "type": "string", "default": "Website by" },
		"creditName": { "type": "string", "default": "jamalakbara.com" },
		"creditUrl": { "type": "string", "default": "https://jamalakbara.com" }
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"multiple": true
	},
	"editorScript": "miroir-blocks-site",
	"render": "file:./render.php",
	"miroir": {
		"controls": [
			{
				"attr": "format",
				"type": "text",
				"label": "Text",
				"help": "Empty: © {year} {site}"
			},
			{ "attr": "creditLabel", "type": "text", "label": "Website credit label" },
			{ "attr": "creditName", "type": "text", "label": "Website credit name (empty: hide credit)" },
			{ "attr": "creditUrl", "type": "text", "label": "Website credit URL" }
		]
	}
}
