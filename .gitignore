# Secrets
.env

# Content snapshots (customer data, password hashes) and pre-import backups: tools/snapshot.sh
.snapshots/
.snapshots-backup/

# WordPress runtime
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/debug.log

# Third-party plugins/themes installed via WP-CLI (track only our own code)
wp-content/plugins/*
wp-content/themes/*
!wp-content/plugins/miroir-*/
!wp-content/themes/miroir-*/

# Office lock/temp files
~$*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.aimem/.cache/

# Client quotation (private)
docs/Quotation Webdev Miroir.pdf

# Licensed design-only fonts (supply locally per machine, never commit)
docs/design/fonts/*
!docs/design/fonts/README.md

# Licensed webfonts supplied by the site owner; keep available locally for deployment.
wp-content/themes/miroir-theme/assets/fonts/Avenir-*.ttf
