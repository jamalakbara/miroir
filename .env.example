WP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE=Miroir
WP_ADMIN_USER=admin
WP_ADMIN_EMAIL=admin@example.test
WP_ADMIN_PASSWORD=change-me

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# Shared folder for tools/snapshot.sh (database, uploads, fonts). Private; both machines sync it.
# Windows: G:/My Drive/miroir-snapshots   macOS: ~/Library/CloudStorage/GoogleDrive-<you>/My Drive/miroir-snapshots
MIROIR_SNAPSHOT_DIR=

# Recommended: move uploads through the server instead of a 1+ GB uploads.tar in the snapshot
# folder. Export mirrors wp-content/uploads to this folder (rsync, only changed files); import
# pulls from it. Use a PRIVATE folder outside public_html (export refuses public_html). Same
# value on every machine. SSH user, host and port are in hPanel > Advanced > SSH Access.
# MIROIR_UPLOADS_REMOTE=user@host:~/miroir-sync/uploads
# MIROIR_UPLOADS_SSH_PORT=65002
# MIROIR_UPLOADS_SSH_KEY=~/.ssh/your_key
# MIROIR_UPLOADS_RSYNC=0   # force ssh + tar when rsync misbehaves
