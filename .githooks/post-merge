#!/bin/sh
# After git pull: apply the vendor plugin changes the other machine committed to plugins.txt,
# and say when the shared content snapshot is newer than this machine's. Skip with MIROIR_SKIP_HOOKS=1.
[ -n "${MIROIR_SKIP_HOOKS:-}" ] && exit 0
if ! git diff --quiet ORIG_HEAD HEAD -- plugins.txt 2>/dev/null; then
	bash tools/plugins.sh sync --hook --from ORIG_HEAD || echo "plugins: sync failed; fix the error above and run tools/plugins.sh sync" >&2
fi
[ -f .env ] && bash tools/snapshot.sh status --hint 2>/dev/null
exit 0
