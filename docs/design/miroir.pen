              "textGrowth": "fixed-width",
              "width": 720,
              "content": "Quiet, editorial, grayscale. Photography carries the colour. Avenir Roman for reading, navigation, prices and forms; DM Mono for product names, short headings and accent labels. Keep the original miroir SVG logo. Hairlines and outline buttons instead of cards and shadows. One solid button per screen, for the main action.",
              "lineHeight": 1.6,
              "fontFamily": "$font-sans",
              "fontSize": "$text-base",
              "letterSpacing": 0.3
            }
