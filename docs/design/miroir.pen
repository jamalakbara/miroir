                    {
                      "type": "frame",
                      "id": "rBI9w",
                      "name": "Browse Editorial",
                      "context": "Velvet-inspired width-led editorial rhythm, preserving Miroir photos and page-gutter captions. Desktop/tablet share8:5 canvases with max width1280; desktop/tablet spacing64px top/32px bottom. Mobile uses portrait canvases with112px top/48px bottom. Native continuous scrolling; no forced viewport fit or added effects.",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 18,
                      "padding": [
                        "$editorial-space-t",
                        32,
                        32,
                        32
                      ],
                      "children": [
