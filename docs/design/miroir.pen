    {
      "type": "frame",
      "id": "Z5Qv0z",
      "x": 3200,
      "y": -4110,
      "name": "Image Placeholder",
      "context": "Photo loading behavior — desktop, tablet and mobile: real photos show the existing grey media area with no icon while pending. A translucent white highlight sweeps left to right over 1.4s, repeating until the primary image loads. Reduced motion keeps a static grey area. Loaded and cached photos display immediately with unchanged dimensions. Failed primary photos show the existing grey image-icon fallback and retain the image label; failed hover images stay hidden. Static design placeholders never animate. Applies to product cards, galleries, editorial images, banners and cart thumbnails through the shared media helper, including dynamically inserted cards. Product photos remain disabled by default.",
      "reusable": true,
      "width": 240,
      "height": 320,
      "fill": "$ph",
      "layout": "vertical",
      "justifyContent": "center",
